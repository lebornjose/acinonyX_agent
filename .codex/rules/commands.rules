# Project command rules.
# Keep command permissions narrow; destructive commands remain blocked by default.

prefix_rule(
  pattern = ["pnpm", "install"],
  decision = "allow",
)

prefix_rule(
  pattern = ["pnpm", "build"],
  decision = "allow",
)

prefix_rule(
  pattern = ["pnpm", "test"],
  decision = "allow",
)

prefix_rule(
  pattern = ["pnpm", "--filter"],
  decision = "allow",
)

prefix_rule(
  pattern = ["git", "status"],
  decision = "allow",
)

prefix_rule(
  pattern = ["git", "diff"],
  decision = "allow",
)
