LLM_PROVIDER=openai-compatible
LLM_API_KEY=your-model-api-key
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
# 同花顺金融数据 API：在 https://fuyao.aicubes.cn/admin 创建后填入。
# 不要将真实 Key 提交到仓库或写入日志。
HITHINK_FINANCE_API_KEY=
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn
HITHINK_FINANCE_TIMEOUT_MS=10000
# Tushare Pro 估值数据：用于 PE、PB、市值和换手率；未配置时股票分析会跳过估值数据。
TUSHARE_TOKEN=
TUSHARE_BASE_URL=https://api.tushare.pro
TUSHARE_TIMEOUT_MS=10000
API_PORT=4001
AGENT_PORT=4002
AGENT_SERVICE_URL=http://localhost:4002
AGENT_TIMEOUT_MS=90000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=agent_platform
MYSQL_CONNECTION_LIMIT=10

# Prisma schema 备用配置
DATABASE_URL=mysql://root:your-mysql-password@localhost:3306/agent_platform

# 阿里云 OSS 静态文件上传（build:upload 使用）
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_PUBLIC_BASE_URL=
ALIYUN_OSS_URL=
ALIYUN_OSS_UPLOAD_PREFIX=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
